# Platform
DATABASE_URL=postgresql://user:pass@localhost:5432/rexify
JWT_SECRET=change-me-min-32-characters-long-secret
PORT=3000

# Bot API tokens (di-inject ke config.json tiap instance)
REX_API_KEY=

# Root folder deployment (/home/rexify di VPS Linux).
# Wajib berisi: core/ (codebase rex-bot-v2) dan instances/ (dibuat otomatis platform).
REXIFY_ROOT=/home/rexify

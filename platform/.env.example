# Platform
DATABASE_URL=postgresql://user:pass@localhost:5432/rexify
JWT_SECRET=change-me-min-32-characters-long-secret
PORT=3000

# SMTP Zoho untuk kirim OTP verifikasi email & reset password
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=support@rexapi.my.id
SMTP_PASS=
SMTP_FROM=Rexify <support@rexapi.my.id>

# Bot API tokens (di-inject ke config.json tiap instance)
REX_API_KEY=
JEREXD_API_KEY=

# Root folder deployment (/home/rexify di VPS Linux).
# Wajib berisi: core/ (codebase rex-bot-v2) dan instances/ (dibuat otomatis platform).
REXIFY_ROOT=/home/rexify

# Bot Runner: 'same' = PM2 langsung di mesin platform, 'other' = HTTP ke Bot Runner Agent.
BOT_RUNNER_MODE=same
BOT_RUNNER_URL=
BOT_RUNNER_SECRET=

# Token ops untuk POST /api/ops/catalog/refresh (header: x-catalog-token).
# Kosong = endpoint dimatikan (503). Isi dengan string acak panjang.
CATALOG_REFRESH_TOKEN=

# Midtrans Core API (QRIS/GoPay). Sandbox key diawali SB-Mid-server-, production Mid-server-.
# Webhook: https://<domain>/api/billing/webhook (atur di dashboard Midtrans).
MIDTRANS_SERVER_KEY=
MIDTRANS_ENV=sandbox
